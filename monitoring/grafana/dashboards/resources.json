{
  "uid": "resources",
  "title": "리소스 (USE)",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 39,
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Kafka 컨슈머",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "밀린 메시지 수 (lag)",
      "description": "브로커 기준으로 계산하므로 컨슈머가 죽어 있어도 보인다",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{consumergroup}} (토픽: {{topic}})",
          "expr": "sum by (consumergroup, topic) (kafka_consumergroup_lag{consumergroup=~\"${service}-group.*\"})"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "컨슈머 스레드 사용률 (가장 바쁜 스레드)",
      "description": "1에 가까우면 쉬지 않고 처리 중. lag이 함께 늘면 concurrency 부족",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{job}} ({{group}})",
          "expr": "max by (job, group) (label_replace(1 - kafka_consumer_poll_idle_ratio_avg{job=~\"$service\"}, \"group\", \"$1\", \"client_id\", \"consumer-(.*)-[0-9]+\"))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "리밸런스 횟수",
      "description": "리밸런스 동안 소비가 멈춘다. 배포 외 시점에 생기면 처리 지연을 의심",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{job}} ({{group}})",
          "expr": "sum by (job, group) (label_replace(increase(kafka_consumer_coordinator_rebalance_total{job=~\"$service\"}[$__rate_interval]), \"group\", \"$1\", \"client_id\", \"consumer-(.*)-[0-9]+\"))"
        }
      ]
    },
    {
      "id": 101,
      "type": "row",
      "title": "Kafka 프로듀서 (outbox 발행)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "전송 버퍼 사용률",
      "description": "가득 차면 send()가 블록되어 outbox 발행이 밀린다",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{job}}",
          "expr": "max by (job) (1 - kafka_producer_buffer_available_bytes{job=~\"$service\"} / kafka_producer_buffer_total_bytes{job=~\"$service\"})"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "전송 에러",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{job}}",
          "expr": "sum by (job) (rate(kafka_producer_record_error_total{job=~\"$service\"}[$__rate_interval]))"
        }
      ]
    }
  ],
  "description": "자원이 얼마나 쓰이고(U), 밀리고(S), 실패하는가(E)",
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "서비스",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(http_server_requests_milliseconds_count, job)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(http_server_requests_milliseconds_count, job)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  }
}
