          "calcs": [
            "mean",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "[{{datname}}] {{query}}",
          "expr": "topk(10, sum by (datname, query) (rate(pg_stat_statements_calls_total{service=~\"$service\", datname=~\"order|payment\"}[$__rate_interval]) * on (instance, queryid) group_left (query) max by (instance, queryid, query) (pg_stat_statements_query_id{query!~\"(?is).*pg_.*\"})))"
        }
