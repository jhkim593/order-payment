    {
      "type": "timeseries",
      "title": "주문 요청 (응답 코드별)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{status}}",
          "expr": "sum by (status) (rate(http_server_requests_milliseconds_count{job=\"order-service\", method=\"POST\", uri=\"/api/v1/orders\"}[$__rate_interval]))"
        }
      ],
      "id": 1,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 1
      }
    },
